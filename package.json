{
  "name": "zenit-alanya-quality",
  "version": "1.0.0",
  "private": true,
  "description": "Development-only quality gates for the static Zenit Alanya concept",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node qa/pipeline.cjs",
    "test:browser": "playwright test -c qa/playwright.config.cjs",
    "test:http": "node --test qa/http.test.cjs",
    "test:performance": "node qa/performance.cjs",
    "test:security": "node qa/security-check.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "lighthouse": "13.5.0"
  }
}
